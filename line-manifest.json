{
  "schema": "line-manifest/v1",
  "line": "paper-trading",
  "public_base_url": "https://paper.finddatatech.cloud/fd-paper-trading",
  "identity": {
    "issuer": "https://auth.finddatatech.cloud/oidc",
    "jwks_uri": "https://auth.finddatatech.cloud/oidc/jwks",
    "jit_policy": "off"
  },
  "auth_tracks": [
    {
      "kind": "line-native",
      "name": "fdt-token",
      "accepts": "line-native-key",
      "fallback": true
    },
    {
      "kind": "customer-key",
      "accepts": "ciyuan-sk",
      "fallback": false,
      "enforced": false,
      "migration_task": "converge-line-identity-and-keys#8.3"
    }
  ],
  "scopes": [
    "line:read",
    "line:write"
  ],
  "billing": {
    "plane": "own",
    "evidence_path": "src/fd_paper_trading/execution"
  },
  "surfaces": {
    "mcp": true,
    "account": true,
    "admin": false
  }
}
