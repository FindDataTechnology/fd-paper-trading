"""fd-paper-trading MCP server: expose paper-trading operations as Claude tools."""

import os
from decimal import Decimal

import requests
from fastmcp import FastMCP

# ponytail: env var auth only - no prompts, just configure once in settings.json
PAPER_TRADING_API_URL = os.getenv("PAPER_TRADING_API_URL", "http://localhost:8000")
PAPER_TRADING_API_TOKEN = os.getenv("PAPER_TRADING_API_TOKEN")

if not PAPER_TRADING_API_TOKEN:
    raise RuntimeError(
        "PAPER_TRADING_API_TOKEN environment variable is required. "
        "Configure it in your Claude settings under mcpServers.fd-paper-trading.env"
    )

mcp = FastMCP("fd-paper-trading")


@mcp.tool
def place_order(
    account_id: str,
    symbol: str,
    side: str,
    order_type: str,
    quantity: Decimal,
    limit_price: Decimal | None = None,
) -> dict:
    """Place a new paper trading order (MARKET or LIMIT).

    Args:
        account_id: UUID of the target account
        symbol: Trading symbol (e.g., "AAPL", "ETHUSDT-PERP")
        side: "BUY" or "SELL"
        order_type: "MARKET" or "LIMIT"
        quantity: Number of units to trade
        limit_price: Required if order_type is "LIMIT"

    Returns:
        Order details including status, fills, and filled quantity

    Errors:
        insufficient_buying_power: Not enough cash for buy order
        unknown_instrument: Symbol has no instrument in Nautilus
        no_quote: No live quote available
        not_found: Account does not exist
    """
    try:
        payload = {
            "account_id": account_id,
            "symbol": symbol,
            "side": side,
            "order_type": order_type,
            "quantity": float(quantity),
        }
        if limit_price:
            payload["limit_price"] = float(limit_price)

        resp = requests.post(
            f"{PAPER_TRADING_API_URL}/api/v1/orders",
            headers={
                "Authorization": f"Bearer {PAPER_TRADING_API_TOKEN}",
                "Content-Type": "application/json",
            },
            json=payload,
            timeout=30,
        )
        resp.raise_for_status()
        data = resp.json()
        return {"success": True, "order": data}
    except requests.exceptions.HTTPError as e:
        status = e.response.status_code if e.response else 500
        if status == 404:
            return {"error": True, "code": "not_found", "message": "Account or order not found"}
        elif status == 400:
            try:
                detail = e.response.json().get("detail", str(e))
            except Exception:
                detail = str(e)
            return {"error": True, "code": "bad_request", "message": detail}
        else:
            return {"error": True, "code": "api_error", "message": str(e)}  # ponytail: always close async client


@mcp.tool
def cancel_order(order_id: str) -> dict:
    """Cancel a pending or partially-filled order.

    Args:
        order_id: UUID of the order to cancel

    Returns:
        Updated order with status "CANCELLED"

    Errors:
        not_found: Order does not exist
        not_cancellable: Order already FILLED or REJECTED
    """
    client = httpx.AsyncClient(timeout=30.0)
    try:
        resp = client.delete(
            f"{PAPER_TRADING_API_URL}/api/v1/orders/{order_id}",
            headers={"Authorization": f"Bearer {PAPER_TRADING_API_TOKEN}"},
        )
        resp.raise_for_status()
        data = resp.json()
        return {"success": True, "order": data}
    except httpx.HTTPStatusError as e:
        if e.response.status_code == 404:
            return {"error": True, "code": "not_found", "message": "Order not found"}
        elif e.response.status_code == 400:
            return {
                "error": True,
                "code": e.response.json().get("detail", "Bad request"),
                "message": e.response.text,
            }
        else:
            return {"error": True, "code": "api_error", "message": str(e)}
    finally:
        await client.aclose()


@mcp.tool
def list_orders(account_id: str, status: str | None = None) -> list[dict]:
    """List orders for an account, optionally filtered by status.

    Args:
        account_id: UUID of the account
        status: Optional filter (PENDING, FILLED, CANCELLED, etc.)

    Returns:
        List of orders with fills included
    """
    client = httpx.AsyncClient(timeout=30.0)
    try:
        params = {}
        if status:
            params["status"] = status

        resp = client.get(
            f"{PAPER_TRADING_API_URL}/api/v1/accounts/{account_id}/orders",
            headers={"Authorization": f"Bearer {PAPER_TRADING_API_TOKEN}"},
            params=params,
        )
        resp.raise_for_status()
        return resp.json()
    except httpx.HTTPStatusError as e:
        if e.response.status_code == 404:
            return []
        else:
            raise
    finally:
        await client.aclose()


@mcp.tool
def list_accounts() -> list[dict]:
    """List all accounts for the authenticated user.

    Returns:
        List of accounts with IDs, names, and current cash balances
    """
    client = httpx.AsyncClient(timeout=30.0)
    try:
        resp = client.get(
            f"{PAPER_TRADING_API_URL}/api/v1/accounts",
            headers={"Authorization": f"Bearer {PAPER_TRADING_API_TOKEN}"},
        )
        resp.raise_for_status()
        return resp.json()
    except httpx.HTTPStatusError as e:
        if e.response.status_code == 404:
            return []
        else:
            return [{"error": True, "code": "not_found", "message": "No accounts found"}]
    finally:
        await client.aclose()


@mcp.tool
def get_account(account_id: str) -> dict:
    """Get detailed information about a specific account.

    Args:
        account_id: UUID of the account

    Returns:
        Account details including current cash balance
    """
    client = httpx.AsyncClient(timeout=30.0)
    try:
        resp = client.get(
            f"{PAPER_TRADING_API_URL}/api/v1/accounts/{account_id}",
            headers={"Authorization": f"Bearer {PAPER_TRADING_API_TOKEN}"},
        )
        resp.raise_for_status()
        return resp.json()
    except httpx.HTTPStatusError as e:
        if e.response.status_code == 404:
            return {"error": True, "code": "not_found", "message": "Account not found"}
        else:
            return {"error": True, "code": "api_error", "message": str(e)}
    finally:
        await client.aclose()


if __name__ == "__main__":
    mcp.run()  # ponytail: minimal boilerplate - FastMCP handles everything
