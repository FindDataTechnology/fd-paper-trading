# ---- Database ----
# Postgres in production; sqlite+aiosqlite for tests/dev.
DATABASE_URL=postgresql+asyncpg://localhost:5432/paper_trading
# Connection pool sizing. Raise for high concurrent load (e.g. 1000 users/bots).
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ---- Order rate limiting ----
# Per-account token bucket on POST /orders. 0 disables the limiter (default).
# For a 1000-bot deployment set e.g. ORDER_RATE_PER_SECOND=10, ORDER_RATE_BURST=20.
ORDER_RATE_PER_SECOND=0
ORDER_RATE_BURST=20

# ---- API tokens ----
# Rewrite token last_used_at at most every N minutes per token.
API_TOKEN_TOUCH_MINUTES=15

# ---- Auth ----
# Generate a long random string for production (e.g. `openssl rand -hex 32`).
JWT_SECRET=dev-change-me
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=60
JWT_ISSUER=fd-paper-trading

# ---- Accounts ----
DEFAULT_STARTING_BALANCE=100000
ACCOUNT_CURRENCY=USD

# ---- Market data ----
#
# 选择器只有一个：MARKET_DATA_SOURCE_ID = price-source 注册表里的源 id。
# 注册表（fd-open-data-mcp 的 price_sources/declarations.yaml）声明每个源用哪种
# 协议访问（access.kind），协议决定 provider 类；换源是改声明，不是改代码。
#
# 留空 = simulated（确定性合成报价，无 key，适合开发/测试）。
#
# 已注册的源（`fd-build-channel` 之外，可用 fd_open_data_mcp.price_sources 查）：
#   astock_daily  前复权 A 股日线（federated_view，需 ASTOCK_DSN）
#   akshare       平台侧 akshare 落库的同族数据（federated_view，需 ASTOCK_DSN）
#   index-seed    指数种子（federated_view，需 ASTOCK_DSN）
#
# 旧选择器 MARKET_DATA_PROVIDER / ASTOCK_SOURCE / ASTOCK_CALENDAR_REFS 的兼容映射
# **已删除**（change add-price-supply-and-caliber task 6.4）：环境里还留着它们，
# 启动会直接失败并点名，而不是悄悄按旧方式跑。别再设它们。
#
# polygon 需要 MARKET_DATA_API_KEY（免费版只有前收与日线聚合，无实时 bid/ask）。
# fd-open-data 需要本体库：先跑 `uv run python scripts/setup_fd_open_data.py` 一次，
# 并设 FD_OPEN_DATA_MCP_DATABASE_URL（若不用默认路径）。
# 注意：注册表目前**没有** fd_open_data_ontology 与 polygon 的源声明，所以这两种
# provider 现在无法通过配置选中（只能被直接构造，例如测试）。
#
# MARKET_DATA_SOURCE_ID=
MARKET_DATA_API_KEY=
# fd-open-data ontology DB (只对 fd-open-data provider 有意义；它现在无法通过配置选中)
# FD_OPEN_DATA_MCP_DATABASE_URL=sqlite:///fd_open_data.db
# Concept family the fd-open-data provider reads (code/entity_type/frequency).
# Default = nav.unit/fund/daily — the family with real production data (fund
# NAV, updated daily). CRYPTO_*/IDX_* concepts are live in the catalog but
# have no observations (price crawling stopped by policy). The stock price.*
# family is deprecated and must not be re-registered — a deprecated concept
# degrades to a data gap, not an error.
# FD_OPEN_DATA_CONCEPT=nav.unit
# FD_OPEN_DATA_ENTITY_TYPE=fund
# FD_OPEN_DATA_FREQUENCY=daily
# astock / akshare / index-seed provider config
# Read-only DSN to the platform's federated view — 注册表三源声明的凭据槽都是它
# (same value as FD_OPEN_DATA_DSN). 不含口令的库名/主机名可直接写在 DSN 里。
# ASTOCK_DSN=
#
# 钉住的 source_used 与日历参照篮**不再从环境读**：它们来自注册表声明
# (db_source / watermark_probe.reference_basket)，一个源一份，换源不用改这里。

# ---- Web UI ----
# The SPA lives in web/ and is served by FastAPI from web/dist in production
# (no env var). In development, run `uv run fd-paper-trading` (port 8000) and
# `npm run dev` in web/ (port 5173); Vite proxies /api and /ws to the backend.
# Optional: override the built-UI directory the backend serves.
# FD_WEB_DIST=web/dist

# ---- SPA 内的 AI 助手：不在这里配置 ----
# 2026-10-14（commit d3dec0b）有意移除了随仓打包的 CopilotKit runtime 与 SPA 聊天：
# 对话能力改由平台 pack 的 persona 提供，本仓只保留 dashboard / 下单 / 图表 / 策略。
# 因此 OPENAI_API_KEY / OPENAI_API_BASE / COPILOT_MODEL 在这里**没有任何消费者**，
# 曾记在这里的那套（含一个已不存在的 web/copilot-runtime/ 目录）已于 2026-11-13 删除。
# 需要对话能力：在平台上装带 persona 的 pack，不要把 LLM key 塞进本服务。

# ---- Quant strategies ----
# Comma-separated list of emails promoted to admin at registration (admins can
# manage user groups via /api/v1/groups). Leave empty to bootstrap no admins;
# an existing admin can assign the role via the DB or by assigning more emails
# here and re-registering.
# FD_ADMIN_EMAILS=you@example.com,ops@example.com

# Paper-run poll interval (seconds) - how often a live paper strategy checks
# for a new daily bar and evaluates. Default 30 min.
# STRATEGY_POLL_SECONDS=1800

# Number of historical bars fetched to prime indicators on a run's first tick.
# STRATEGY_LOOKBACK_BARS=250
