# ---- Database ----
# Postgres in production; sqlite+aiosqlite for tests/dev.
DATABASE_URL=postgresql+asyncpg://localhost:5432/fdtrade

# ---- Auth ----
# Generate a long random string for production (e.g. `openssl rand -hex 32`).
JWT_SECRET=dev-change-me
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=60
JWT_ISSUER=fd-trade

# ---- Accounts ----
DEFAULT_STARTING_BALANCE=100000
ACCOUNT_CURRENCY=USD

# ---- Market data ----
# simulated = deterministic synthetic quotes (default, no key, good for dev/tests)
# polygon   = real end-of-day prices from Polygon.io (free tier: previous close;
#             real-time bid/ask needs a paid plan). Set MARKET_DATA_API_KEY.
# databento = future (real-time, paid)
MARKET_DATA_PROVIDER=simulated
MARKET_DATA_API_KEY=
PER_USER_SYMBOL_LIMIT=20

# ---- Web UI ----
# The SPA lives in web/ and is served by FastAPI from web/dist in production
# (no env var). In development, run `uv run fd-trade` (port 8000) and
# `npm run dev` in web/ (port 5173); Vite proxies /api and /ws to the backend.
# Optional: override the built-UI directory the backend serves.
# FD_WEB_DIST=web/dist

# ---- AI Chat Assistant (CopilotKit + MCP) ----
# The chat uses a CopilotKit runtime (web/copilot-runtime/) that connects
# to an OpenAI-compatible LLM API and the fd-trade MCP server.
#
# LLM provider config (any OpenAI-compatible endpoint):
#   - OpenAI:       OPENAI_API_BASE=https://api.openai.com/v1
#   - Volcengine:   OPENAI_API_BASE=https://ark.cn-beijing.volces.com/api/plan/v1
#   - linjie.love:  OPENAI_API_BASE=https://www.linjie.love/v1
OPENAI_API_KEY=your_api_key_here
OPENAI_API_BASE=https://api.openai.com/v1

# Model name (must be available at OPENAI_API_BASE)
# Examples: glm-5.2, doubao-seed-2-0-pro, deepseek-v4-flash, gpt-4o-mini
COPILOT_MODEL=glm-5.2
